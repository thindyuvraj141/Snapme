rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Id of the "unfriend" record for the signed-in user and another user.
    function pairId(o) {
      return request.auth.uid < o ? request.auth.uid + '_' + o : o + '_' + request.auth.uid;
    }

    // A new 1-to-1 chat can only be created if:
    //  - the other person has a public account AND you two have not unfriended each other, or
    //  - the other person sent YOU a friend request that is still pending (you are accepting it).
    function dmAllowed() {
      let m = request.resource.data.members;
      let o = m[0] == request.auth.uid ? m[1] : m[0];
      return (get(/databases/$(db)/documents/users/$(o)).data.get('private', false) == false
              && !exists(/databases/$(db)/documents/unfriends/$(pairId(o))))
          || (exists(/databases/$(db)/documents/requests/$(o + '_' + request.auth.uid))
              && get(/databases/$(db)/documents/requests/$(o + '_' + request.auth.uid)).data.status == 'pending');
    }

    // Expo Push: every member keeps ONLY their own push token in chats/<id>.xpt.<uid> = { t: token, l: 1 if the chat is locked }.
    // Only members can read a chat, so only the people in a chat can see it (the sender's phone needs it to send the push).
    function xptOk() {
      let n = request.resource.data.get('xpt', {});
      let o = resource.data.get('xpt', {});
      return n.diff(o).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in n)
            || (n[request.auth.uid].keys().hasOnly(['t', 'l'])
                && n[request.auth.uid].t is string && n[request.auth.uid].t.size() < 200));
    }

    function member(c) {
      return request.auth != null && request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members;
    }

    // ---- Admin panel (a separate website, see ADMIN-SITE-README.txt) ----
    // An admin is a person whose user id has a document in the `admins` collection. The first (owner) document is created
    // once by hand in the Firebase console (see the admin site's README); after that the owner can add admins from the panel.
    //   role 'owner': everything.   role 'mod': users (suspend / warn / clean-up), appeals, reports and notes only.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function isOwner() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid))
          && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.get('role', 'mod') == 'owner';
    }
    // A banned person can still log in (to be told why) but cannot send messages, create chats or send friend requests.
    // A suspension can have an end time (`until`): after that time the person is free again, even before an admin removes the record.
    function notBanned() {
      let p = /databases/$(db)/documents/bans/$(request.auth.uid);
      return !exists(p) || (get(p).data.get('until', null) != null && get(p).data.until < request.time);
    }

    match /users/{u} {
      allow read: if request.auth != null;
      // You write your own profile, but you cannot give yourself the verified badge or touch `modAt` (set by admins).
      allow create: if request.auth != null && request.auth.uid == u
        && !('verified' in request.resource.data) && !('modAt' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == u
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'modAt']);
      allow delete: if request.auth != null && request.auth.uid == u;
      // The owner gives or takes away the verified badge.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified']);
      // Any admin can clean up a bad name, username or photo (the person's app then fixes the copies in his chats).
      // Only the owner can do this to another admin.
      allow update: if isAdmin() && request.auth.uid != u && (isOwner() || !exists(/databases/$(db)/documents/admins/$(u)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'username', 'photo', 'cover', 'modAt']);
    }

    // A username is claimed once. When its owner changes it, the old one is marked "retired"
    // and nobody (including the owner) can use it again.
    match /usernames/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid
        || (isAdmin() && n.matches('user[0-9]{6}') && request.resource.data.keys().hasOnly(['uid'])
            && (isOwner() || !exists(/databases/$(db)/documents/admins/$(request.resource.data.uid)))));
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid
        || (isAdmin() && (isOwner() || !exists(/databases/$(db)/documents/admins/$(resource.data.uid)))))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retired'])
        && request.resource.data.get('retired', false) == true;
      allow delete: if request.auth != null && ((resource.data.uid == request.auth.uid
        && !resource.data.get('retired', false)) || isOwner());
    }

    match /reports/{r} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledTs']);
    }

    // Who is an admin. Read: yourself, or any admin. Only the owner can add / change / remove admins (never himself).
    match /admins/{a} {
      allow get: if request.auth != null && (request.auth.uid == a || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isOwner() && a != request.auth.uid && request.resource.data.role in ['owner', 'mod'];
      allow delete: if isOwner() && a != request.auth.uid;
    }

    // Suspended accounts. You can read your own record (the app shows the reason and logs you out); admins manage them.
    match /bans/{b} {
      allow get: if request.auth != null && (request.auth.uid == b || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && !exists(/databases/$(db)/documents/admins/$(b))
        && (!('until' in request.resource.data) || request.resource.data.until is timestamp);
      allow delete: if isAdmin();
    }

    // Appeals: a suspended person can send ONE message to the admins (and send a new one only after it was answered).
    match /appeals/{a} {
      allow get: if request.auth != null && (request.auth.uid == a || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == a
        && exists(/databases/$(db)/documents/bans/$(a))
        && request.resource.data.keys().hasOnly(['text', 'ts', 'status'])
        && request.resource.data.status == 'new'
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.ts == request.time;
      allow update: if request.auth != null && request.auth.uid == a
        && exists(/databases/$(db)/documents/bans/$(a))
        && resource.data.status != 'new'
        && request.resource.data.keys().hasOnly(['text', 'ts', 'status'])
        && request.resource.data.status == 'new'
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.ts == request.time;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'handledBy', 'handledTs']);
      allow delete: if isAdmin();
    }

    // A warning from the admins to one person (the newest one replaces the old one). The person can only read it.
    // Only the owner can warn another admin.
    match /warnings/{w} {
      allow get: if request.auth != null && (request.auth.uid == w || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && w != request.auth.uid && (isOwner() || !exists(/databases/$(db)/documents/admins/$(w)))
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400;
      allow delete: if isAdmin();
    }

    // Private notes of the admins about a person. Only admins can read or write them.
    match /adminnotes/{n} {
      allow get, list, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
    }

    // App settings, switches and the current announcement. Everybody may read them (they are needed before login too);
    // only the owner may change them.
    match /config/{d} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Log of what the admins did. Nobody can change or delete an entry.
    match /adminlog/{l} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
    }

    match /users/{u}/sessions/{s} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }
    match /users/{u}/private/{d} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }

    // Big (512px) copy of a profile picture, fetched only when somebody opens the photo full screen.
    // Written by its owner only; an admin can remove it together with a bad photo.
    match /photos/{u} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['b', 'ts'])
        && request.resource.data.b is string && request.resource.data.b.size() < 300000;
      allow delete: if request.auth != null && (request.auth.uid == u || isAdmin());
    }

    match /blocks/{b} {
      allow read: if request.auth != null && (resource == null || resource.data.by == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow update: if request.auth != null && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid;
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }

    // Written when someone unfriends: the pair must send/accept a new request to chat again.
    match /unfriends/{p} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow create, update: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && p == pairId(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Request id must be "<from>_<to>" so nobody can fake a request from someone else.
    match /requests/{r} {
      allow read: if request.auth != null && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && r == request.resource.data.from + '_' + request.resource.data.to
        && notBanned();
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Shared position (Friends map). One document per person, written only by that person and only while
    // they have sharing turned on. `to` lists the friends who may see it; only those people can read it.
    match /locs/{u} {
      allow get: if request.auth != null && (request.auth.uid == u || request.auth.uid in resource.data.to);
      allow list: if request.auth != null && request.auth.uid in resource.data.to;
      allow create, update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['u', 'la', 'lo', 'ac', 'ts', 'to'])
        && request.resource.data.u == u
        && request.resource.data.la is number && request.resource.data.la >= -90 && request.resource.data.la <= 90
        && request.resource.data.lo is number && request.resource.data.lo >= -180 && request.resource.data.lo <= 180
        && request.resource.data.ts is timestamp
        && request.resource.data.to is list && request.resource.data.to.size() <= 500;
      allow delete: if request.auth != null && request.auth.uid == u;
    }

    // Snaps (the Feed). A snap can be read by the people in its `to` list (the author's friends, or only the Inner Circle) and,
    // when `pub` is true (the author's account was Public when posting), by every signed-in person (the Public feed).
    // The author can only post as himself, with a picture under 300 KB, and may not make a snap public while his account is Private.
    // Everybody who can see a snap may react to it (only their own reaction); only the author (or an admin) can delete it.
    match /posts/{p} {
      allow get, list: if request.auth != null && (resource.data.pub == true || request.auth.uid in resource.data.to);
      allow create: if request.auth != null && notBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nm', 'un', 'img', 'vb', 'ts', 'exp', 'to', 'aud', 'pub', 'pd', 'au', 'ad', 'rx', 'vid', 'tg'])
        && request.resource.data.keys().hasAll(['uid', 'img', 'ts', 'exp', 'to', 'pub', 'rx'])
        && request.resource.data.ts == request.time
        && request.resource.data.img is string && request.resource.data.img.size() < 300000
        && request.resource.data.get('au', '').size() < 200000
        && request.resource.data.get('vb', '').size() <= 60
        && (!('tg' in request.resource.data) || (request.resource.data.tg is list && request.resource.data.tg.size() <= 5))
        && (!('vid' in request.resource.data) || (request.resource.data.vid is map && request.resource.data.vid.n is int
            && request.resource.data.vid.n >= 1 && request.resource.data.vid.n <= 8
            && request.resource.data.vid.mime is string && request.resource.data.vid.mime.size() < 30))
        && request.resource.data.to is list && request.resource.data.to.size() <= 401
        && request.auth.uid in request.resource.data.to
        && request.resource.data.rx.size() == 0
        && (request.resource.data.pub != true
            || get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('private', false) == false);
      allow update: if request.auth != null
        && (resource.data.pub == true || request.auth.uid in resource.data.to)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
        && request.resource.data.rx.diff(resource.data.rx).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.rx) || request.resource.data.rx[request.auth.uid] in ['f', 'h']);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // A video snap is stored in small pieces (video of up to 3 MB, like videos in chats). The post itself keeps the cover picture.
    // Whoever can see the snap can read its pieces; only the author (or an admin) can add or delete pieces.
    match /posts/{p}/parts/{q} {
      allow get, list: if request.auth != null && (isAdmin()
        || get(/databases/$(db)/documents/posts/$(p)).data.pub == true
        || request.auth.uid in get(/databases/$(db)/documents/posts/$(p)).data.to);
      allow create: if request.auth != null && notBanned()
        && request.resource.data.keys().hasOnly(['i', 'd', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 8
        && request.resource.data.d is string && request.resource.data.d.size() <= 720000;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Memories: a private copy of every snap you post, kept 30 days. Only you can read, create or delete them.
    match /users/{u}/memories/{m} {
      allow read, delete: if request.auth != null && request.auth.uid == u;
      allow create: if request.auth != null && request.auth.uid == u && notBanned()
        && request.resource.data.keys().hasOnly(['ts', 'img', 'vb', 'au', 'ad'])
        && request.resource.data.img is string && request.resource.data.img.size() < 300000
        && request.resource.data.get('au', '').size() < 200000;
    }

    match /chats/{c} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
        && (request.resource.data.type != 'dm' || (request.resource.data.members.size() == 2 && dmAllowed()))
        && notBanned();
      // members can remove a 1-to-1 chat (unfriend); an admin can remove any chat (from a report)
      allow delete: if request.auth != null && ((request.auth.uid in resource.data.members && resource.data.type == 'dm') || isAdmin());
      allow update: if request.auth != null && request.auth.uid in resource.data.members && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','lastTs','lastFrom','seen','deliv','typing','photos','names','exp','emails','unames','un','xpt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['xpt']) || xptOk()))
        || (resource.data.type == 'group' && request.auth.uid in resource.data.get('admins', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','names','photo','admins']))
        || (resource.data.type == 'group'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1));
    }
    match /chats/{c}/messages/{m} {
      // Members read their chat. An admin can open ONE message when he knows its id (it comes from a report) but cannot list a chat.
      allow get: if member(c) || isAdmin();
      allow list: if member(c);
      allow create: if member(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.expireAt is timestamp
        && notBanned();
      allow update: if member(c) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
        || (resource.data.from == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited'])));
      // The sender can always delete a message. In "disappear right after reading" chats the flag `ar` is set
      // on the message and the person who received it deletes it a few seconds after reading.
      allow delete: if (member(c) && (resource.data.from == request.auth.uid || resource.data.get('ar', false) == true)) || isAdmin();
    }
    match /chats/{c}/messages/{m}/parts/{p} {
      allow get: if member(c) || isAdmin();
      allow list: if member(c);
      allow create: if member(c) && notBanned();
      allow delete: if isAdmin();
    }
  }
}
