rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Id of the "unfriend" record for the signed-in user and another user.
    function pairId(o) {
      return request.auth.uid < o ? request.auth.uid + '_' + o : o + '_' + request.auth.uid;
    }

    // A new 1-to-1 chat can only be created if:
    //  - the other person has a public account AND you two have not unfriended each other, or
    //  - the other person sent YOU a friend request that is still pending (you are accepting it).
    function dmAllowed() {
      let m = request.resource.data.members;
      let o = m[0] == request.auth.uid ? m[1] : m[0];
      return (get(/databases/$(db)/documents/users/$(o)).data.get('private', false) == false
              && !exists(/databases/$(db)/documents/unfriends/$(pairId(o))))
          || (exists(/databases/$(db)/documents/requests/$(o + '_' + request.auth.uid))
              && get(/databases/$(db)/documents/requests/$(o + '_' + request.auth.uid)).data.status == 'pending');
    }

    function member(c) {
      return request.auth != null && request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members;
    }

    // ---- Admin panel (a separate website, see ADMIN-SITE-README.txt) ----
    // An admin is a person whose user id has a document in the `admins` collection. The first (owner) document is created
    // once by hand in the Firebase console (see the admin site's README); after that the owner can add admins from the panel.
    //   role 'owner': everything.   role 'mod': users (ban / unban) and reports only.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function isOwner() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid))
          && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.get('role', 'mod') == 'owner';
    }
    // A banned person can still log in (to be told why) but cannot send messages, create chats or send friend requests.
    function notBanned() {
      return !exists(/databases/$(db)/documents/bans/$(request.auth.uid));
    }

    match /users/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }

    // A username is claimed once. When its owner changes it, the old one is marked "retired"
    // and nobody (including the owner) can use it again.
    match /usernames/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || isOwner())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retired'])
        && request.resource.data.get('retired', false) == true;
      allow delete: if request.auth != null && ((resource.data.uid == request.auth.uid
        && !resource.data.get('retired', false)) || isOwner());
    }

    match /reports/{r} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledTs']);
    }

    // Who is an admin. Read: yourself, or any admin. Only the owner can add / change / remove admins (never himself).
    match /admins/{a} {
      allow get: if request.auth != null && (request.auth.uid == a || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isOwner() && a != request.auth.uid && request.resource.data.role in ['owner', 'mod'];
      allow delete: if isOwner() && a != request.auth.uid;
    }

    // Suspended accounts. You can read your own record (the app shows the reason and logs you out); admins manage them.
    match /bans/{b} {
      allow get: if request.auth != null && (request.auth.uid == b || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && !exists(/databases/$(db)/documents/admins/$(b));
      allow delete: if isAdmin();
    }

    // App settings, switches and the current announcement. Everybody may read them (they are needed before login too);
    // only the owner may change them.
    match /config/{d} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Log of what the admins did. Nobody can change or delete an entry.
    match /adminlog/{l} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
    }

    match /users/{u}/sessions/{s} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }
    match /users/{u}/private/{d} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }

    match /blocks/{b} {
      allow read: if request.auth != null && (resource == null || resource.data.by == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow update: if request.auth != null && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid;
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }

    // Written when someone unfriends: the pair must send/accept a new request to chat again.
    match /unfriends/{p} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow create, update: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && p == pairId(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Request id must be "<from>_<to>" so nobody can fake a request from someone else.
    match /requests/{r} {
      allow read: if request.auth != null && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && r == request.resource.data.from + '_' + request.resource.data.to
        && notBanned();
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Shared position (Friends map). One document per person, written only by that person and only while
    // they have sharing turned on. `to` lists the friends who may see it; only those people can read it.
    match /locs/{u} {
      allow get: if request.auth != null && (request.auth.uid == u || request.auth.uid in resource.data.to);
      allow list: if request.auth != null && request.auth.uid in resource.data.to;
      allow create, update: if request.auth != null && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['u', 'la', 'lo', 'ac', 'ts', 'to'])
        && request.resource.data.u == u
        && request.resource.data.la is number && request.resource.data.la >= -90 && request.resource.data.la <= 90
        && request.resource.data.lo is number && request.resource.data.lo >= -180 && request.resource.data.lo <= 180
        && request.resource.data.ts is timestamp
        && request.resource.data.to is list && request.resource.data.to.size() <= 500;
      allow delete: if request.auth != null && request.auth.uid == u;
    }

    match /chats/{c} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
        && (request.resource.data.type != 'dm' || (request.resource.data.members.size() == 2 && dmAllowed()))
        && notBanned();
      // members can remove a 1-to-1 chat (unfriend); an admin can remove any chat (from a report)
      allow delete: if request.auth != null && ((request.auth.uid in resource.data.members && resource.data.type == 'dm') || isAdmin());
      allow update: if request.auth != null && request.auth.uid in resource.data.members && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','lastTs','lastFrom','seen','deliv','typing','photos','names','exp','emails','unames','un'])
        || (resource.data.type == 'group' && request.auth.uid in resource.data.get('admins', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','names','photo','admins']))
        || (resource.data.type == 'group'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1));
    }
    match /chats/{c}/messages/{m} {
      // Members read their chat. An admin can open ONE message when he knows its id (it comes from a report) but cannot list a chat.
      allow get: if member(c) || isAdmin();
      allow list: if member(c);
      allow create: if member(c) && request.resource.data.from == request.auth.uid
        && request.resource.data.expireAt is timestamp
        && notBanned();
      allow update: if member(c) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
        || (resource.data.from == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited'])));
      // The sender can always delete a message. In "disappear right after reading" chats the flag `ar` is set
      // on the message and the person who received it deletes it a few seconds after reading.
      allow delete: if (member(c) && (resource.data.from == request.auth.uid || resource.data.get('ar', false) == true)) || isAdmin();
    }
    match /chats/{c}/messages/{m}/parts/{p} {
      allow get: if member(c) || isAdmin();
      allow list: if member(c);
      allow create: if member(c) && notBanned();
      allow delete: if isAdmin();
    }
  }
}
